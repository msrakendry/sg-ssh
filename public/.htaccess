# ----------------------------------------------------------------------
# SUDAN SUSTAINABILITY HUB (SSH) — HOSTINGER PRODUCTION .HTACCESS
# Optimized for Hostinger LiteSpeed / Apache Web Hosting (public_html)
# ----------------------------------------------------------------------

# 1. Enable URL Rewriting for Single Page Application (SPA)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS Redirection on Hostinger
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Do not rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other URLs to index.html for React SPA client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Browser Caching & Performance (LiteSpeed / Apache mod_expires)
<IfModule mod_expires.c>
  ExpiresActive On

  # Images and Web Media
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Web Fonts
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"

  # CSS and JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"

  # HTML & JSON (Revalidate quickly for content updates)
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 3. GZIP / Brotli Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
  # Prevent MIME-sniffing
  Header set X-Content-Type-Options "nosniff"

  # Cross-site scripting protection
  Header set X-XSS-Protection "1; mode=block"

  # Prevent clickjacking while allowing safe embeds
  Header set X-Frame-Options "SAMEORIGIN"

  # Referrer policy for privacy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Enforce UTF-8 charset
  AddDefaultCharset UTF-8
</IfModule>

# Disable Directory Browsing
Options -Indexes
